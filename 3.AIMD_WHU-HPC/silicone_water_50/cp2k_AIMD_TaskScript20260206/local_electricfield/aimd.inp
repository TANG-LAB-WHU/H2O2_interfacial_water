@SET PROJECT_NAME silicone_water_50
@SET EPS_SCF 1.0E-6

&GLOBAL
  PROJECT ${PROJECT_NAME}_aimd
  RUN_TYPE MD
  PRINT_LEVEL MEDIUM
  ELPA_KERNEL AVX2_BLOCK4
&END GLOBAL

&MOTION
  &MD
    ENSEMBLE NVT
    STEPS 1000
    TIMESTEP 0.5
    TEMPERATURE 298
    &THERMOSTAT
      REGION GLOBAL
      TYPE NOSE
      &NOSE
        LENGTH 4
        TIMECON 100.0
        YOSHIDA 3
      &END NOSE
    &END THERMOSTAT
    &PRINT
      &ENERGY
        &EACH
          MD 1
        &END EACH
      &END ENERGY
    &END PRINT
  &END MD
  &PRINT
    &TRAJECTORY
      FORMAT XYZ
      &EACH
        MD 1
      &END EACH
    &END TRAJECTORY
    &VELOCITIES
      &EACH
        MD 1
      &END EACH
    &END VELOCITIES
    &RESTART
      &EACH
        MD 100
      &END EACH
    &END RESTART
    # Force at each MD step, generated for DeePMD-kit training
    &FORCES
      FORMAT XYZ
      &EACH
        MD 1
      &END EACH
    &END FORCES
    # Stress tensor at each MD step, generated for DeePMD-kit training
    &STRESS
      &EACH
        MD 1
      &END EACH
    &END STRESS
    # Cell information at each MD step, generated for DeePMD-kit training
    &CELL
      &EACH
        MD 1
      &END EACH
    &END CELL
  &END PRINT
&END MOTION

&FORCE_EVAL
  METHOD QS
  STRESS_TENSOR ANALYTICAL
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
    POTENTIAL_FILE_NAME POTENTIAL_UZH
    CHARGE 0
    MULTIPLICITY 1
    UKS
    
    &MGRID
      CUTOFF 600
      REL_CUTOFF 60
      NGRIDS 5
    &END MGRID
    
    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-12
      EXTRAPOLATION ASPC
      EXTRAPOLATION_ORDER 3
    &END QS
    
    &POISSON
      PERIODIC XYZ
      POISSON_SOLVER PERIODIC
    &END POISSON
    
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF ${EPS_SCF}
      MAX_SCF 150
      IGNORE_CONVERGENCE_FAILURE
      &OT ON
        MINIMIZER DIIS
        PRECONDITIONER FULL_ALL
        ENERGY_GAP 0.001
        LINESEARCH 2PNT
        STEPSIZE 0.08
      &END OT
      &OUTER_SCF
        EPS_SCF ${EPS_SCF}
        MAX_SCF 20
      &END OUTER_SCF
      &PRINT
        &RESTART
          BACKUP_COPIES 1
          &EACH
            MD 10
          &END EACH
        &END RESTART
      &END PRINT
    &END SCF
    
    &XC
      &XC_FUNCTIONAL
        &MGGA_X_R2SCAN
        &END MGGA_X_R2SCAN
        &MGGA_C_R2SCAN
        &END MGGA_C_R2SCAN
      &END XC_FUNCTIONAL
      &VDW_POTENTIAL
        DISPERSION_FUNCTIONAL NON_LOCAL
        &NON_LOCAL
          TYPE RVV10
          KERNEL_FILE_NAME rVV10_kernel_table.dat
          PARAMETERS 11.95 0.0093
          CUTOFF 80
        &END NON_LOCAL
      &END VDW_POTENTIAL
    &END XC
    
    ! Electric field to simulate water microdroplet interface conditions
    ! Field strength ~10^9 V/m (~0.36 V/Å) along z-axis (interface normal)
    ! Using displacement field formulation for better interface description
    &PERIODIC_EFIELD
      INTENSITY 0.007              ! a.u. (~0.36 V/Å = 3.6×10^9 V/m)
      POLARISATION 0.0 0.0 1.0     ! Direction: z-axis (perpendicular to interface)
      DISPLACEMENT_FIELD     ! Use displacement field formulation (Stengel2009)
      # D_FILTER 0.0 0.0 1.0         ! Apply only along z-direction
      D_FILTER 1.0 1.0 1.0         ! Apply to all directions
    &END PERIODIC_EFIELD
    
    &PRINT
      &E_DENSITY_CUBE OFF
      &END E_DENSITY_CUBE
      &MO_CUBES OFF
      &END MO_CUBES
    &END PRINT
  &END DFT
  
  &SUBSYS
    &CELL
      ABC 22.0 19.07996254642244 46.35162
      ALPHA_BETA_GAMMA 90.0 90.0 90.0
      PERIODIC XYZ
    &END CELL
    
    &TOPOLOGY
      COORD_FILE_NAME silicone_water_box_optimized.xyz
      COORD_FILE_FORMAT XYZ
    &END TOPOLOGY
    
    &KIND Si
      BASIS_SET TZVP-MOLOPT-MGGA-GTH-q4
      POTENTIAL GTH-MGGA-q4
    &END KIND
    
    &KIND O
      BASIS_SET TZVP-MOLOPT-MGGA-GTH-q6
      POTENTIAL GTH-MGGA-q6
    &END KIND
    
    &KIND C
      BASIS_SET TZVP-MOLOPT-MGGA-GTH-q4
      POTENTIAL GTH-MGGA-q4
    &END KIND
    
    &KIND H
      BASIS_SET TZVP-MOLOPT-MGGA-GTH-q1
      POTENTIAL GTH-MGGA-q1
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
