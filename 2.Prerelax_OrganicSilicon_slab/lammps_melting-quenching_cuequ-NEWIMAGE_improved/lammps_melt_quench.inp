# OPTIMIZED PHYSICS-INFORMED VERSION - Target: 1.10 g/cm³
# 
# Key improvements based on PDMS EOS and Bulk Modulus (1.0-1.5 GPa):
# 1. Peak pressure reduced to 0.5 GPa (5000 bar) which mathematically yields ~1.10 g/cm³.
# 2. Maintains stability with tdamp=0.5, pdamp=10.0.
# 3. Peak temperature capped at 500K. PDMS Tg is 148K, so 500K is highly fluid.
# 4. Gentle multi-stage release (0.5 -> 0 GPa) with slow cooling to lock density.
# =============================================================================

log             melt_quench_log.lammps

units           metal
neighbor        1.0 bin
dimension       3
boundary        p p p
atom_style      atomic
atom_modify     map yes
newton          on

read_data       silicone_slab.lmpdat

# Use dynamic model path passed from command line via -var MODEL_PT_PATH
pair_style      mliap unified ${MODEL_PT_PATH} 0
pair_coeff      * * C H O Si

thermo          100
thermo_style    custom step cpu spcpu temp press pe ke etotal vol density fmax fnorm
thermo_modify   flush yes

# Optimized damping parameters from successful runs
variable        tdamp equal 0.5
variable        pdamp equal 10.0

# -----------------------------------------------------------------------------
# Master trajectory dump - captures entire simulation (minimization + MD)
# -----------------------------------------------------------------------------
dump            full_traj all xyz 500 full_trajectory.xyz
dump_modify     full_traj element C H O Si

dump            full_lmp all custom 500 full_trajectory.lammpstrj id type x y z
dump_modify     full_lmp sort id

# -----------------------------------------------------------------------------
# Step 1: Quick Minimization
# -----------------------------------------------------------------------------
print "Step 1: Quick Minimization"
dump            min_xyz all xyz 100 minimize_traj.xyz
dump_modify     min_xyz element C H O Si

dump            min_lmp all custom 100 minimize_traj.lammpstrj id type x y z
dump_modify     min_lmp sort id

minimize        0.0 1.0e-8 5000 50000

undump          min_xyz
undump          min_lmp

variable        init_density equal $(density)
print "Initial density: ${init_density} g/cm^3"

# -----------------------------------------------------------------------------
# Enable trajectory dumps for MD runs
# -----------------------------------------------------------------------------
dump            xyz_traj all xyz 100 trajectory.xyz
dump_modify     xyz_traj element C H O Si

dump            lmp_traj all custom 100 trajectory.lammpstrj id type x y z
dump_modify     lmp_traj sort id

dump            dcd_traj all dcd 100 trajectory.dcd

velocity        all create 300.0 12345 rot yes dist gaussian
timestep        0.001

# -----------------------------------------------------------------------------
# Step 2: Heating 300K -> 500K
# -----------------------------------------------------------------------------
print "Step 2: Heating 300K -> 500K (1000 steps)"

fix             heat all npt temp 300.0 500.0 ${tdamp} iso 1.0 1.0 ${pdamp}
run             1000
unfix           heat

# -----------------------------------------------------------------------------
# Step 3: Gentle Compression to 0.5 GPa (5000 bar)
# -----------------------------------------------------------------------------
print "Step 3: Compression 1.0 bar -> 5000.0 bar (2000 steps)"

fix             compress all npt temp 500.0 500.0 ${tdamp} iso 1.0 5000.0 ${pdamp}
run             2000
unfix           compress

variable        compressed_density equal $(density)
print "==========================================="
print "Density after compression (5000 bar): ${compressed_density} g/cm^3"
print "==========================================="

# -----------------------------------------------------------------------------
# Step 4: Hold and Cool to lock structure
# -----------------------------------------------------------------------------
print "Step 4a: Hold at 5000 bar - high temp (1000 steps)"
fix             hold1 all npt temp 500.0 500.0 ${tdamp} iso 5000.0 5000.0 ${pdamp}
run             1000
unfix           hold1

print "Step 4b: Cool to 300K under 5000 bar pressure (2000 steps)"
fix             anneal1 all npt temp 500.0 300.0 ${tdamp} iso 5000.0 5000.0 ${pdamp}
run             2000
unfix           anneal1

print "Step 4c: Hold at 300K under 5000 bar - LOCK STRUCTURE (1000 steps)"
fix             anneal1b all npt temp 300.0 300.0 ${tdamp} iso 5000.0 5000.0 ${pdamp}
run             1000
unfix           anneal1b

variable        density_cool equal $(density)
print "Density after cooling at 5000 bar: ${density_cool} g/cm^3"

# -----------------------------------------------------------------------------
# Step 5: Very Slow Pressure Release
# -----------------------------------------------------------------------------
print "Step 5: Slow pressure release 5000 bar -> 1.0 bar at 300K (4000 steps)"
fix             release1 all npt temp 300.0 300.0 ${tdamp} iso 5000.0 1.0 ${pdamp}
run             4000
unfix           release1

variable        density_release equal $(density)
print "Density at 1.0 bar: ${density_release} g/cm^3"

# -----------------------------------------------------------------------------
# Step 6: Final equilibration at ambient (300K, 1.0 bar)
# -----------------------------------------------------------------------------
print "Step 6: Final NPT equilibration at 300K (2000 steps)"

fix             equil1 all npt temp 300.0 300.0 ${tdamp} iso 1.0 1.0 ${pdamp}
run             2000
unfix           equil1

print "Step 7: Final NVT relaxation to stabilize structure (1000 steps)"
fix             equil2 all nvt temp 300.0 300.0 ${tdamp}
run             1000
unfix           equil2

# -----------------------------------------------------------------------------
# Output
# -----------------------------------------------------------------------------
undump          xyz_traj
undump          lmp_traj
undump          dcd_traj
undump          full_traj
undump          full_lmp

write_data      densified_pdms.lmpdat

dump            final all xyz 1 densified_pdms.xyz
dump_modify     final element C H O Si
run             0
undump          final

write_restart   densified_pdms.restart

# -----------------------------------------------------------------------------
# Summary
# -----------------------------------------------------------------------------
variable        target_density equal 1.10
variable        final_density equal $(density)
variable        rel_error equal abs(v_final_density-v_target_density)/v_target_density*100

print "==========================================="
print "OPTIMIZED Melt-Quench Complete!"
print "==========================================="
print "Density Summary (Target: 1.10 g/cm^3):"
print "  Initial density:     ${init_density} g/cm^3"
print "  After compression:   ${compressed_density} g/cm^3"
print "  After cooling (5kbar): ${density_cool} g/cm^3"
print "  After release (1bar):  ${density_release} g/cm^3"
print "  Final density:       ${final_density} g/cm^3"
print "  Target:              ${target_density} g/cm^3"
print "  Relative error:      ${rel_error}%%"
print "==========================================="
print "Output files:"
print "  - densified_pdms.lmpdat     (LAMMPS data format)"
print "  - densified_pdms.xyz        (XYZ format)"
print "  - densified_pdms.restart    (restart file)"
print "  - full_trajectory.xyz       (complete XYZ trajectory)"
print "  - full_trajectory.lammpstrj (complete LAMMPS trajectory)"
print "  - trajectory.xyz            (MD XYZ trajectory)"
print "  - trajectory.lammpstrj      (MD LAMMPS trajectory)"
print "  - trajectory.dcd            (MD DCD trajectory)"
print "  - melt_quench_log.lammps    (LAMMPS log file)"
print "==========================================="
print "Total: ~15,000 steps (High Performance)"
print "Strategy: 500K Peak, 0.5 GPa (5000 bar) Compression, Slow Release"
print "==========================================="
