# =============================================================================
# LAMMPS input script for PDMS melt-quench densification
# =============================================================================
# Purpose: Achieve target density ~1.10 g/cm^3 for crosslinked PDMS
# 
# Workflow:
#   1. Energy minimization
#   2. Heat from 300K to 443K (170C, curing temperature)
#   3. NPT equilibration at 443K (high temperature relaxation)
#   4. Cool down from 443K to 300K
#   5. Final NPT equilibration at 300K
#   6. Output densified structure
#
# Chemistry context:
#   - Curing agent: 2,5-dimethyl-2,5-di(tert-butylperoxy)hexane (1%)
#   - Curing conditions: 170C (443K), 10 min
#   - Target density: 1.10 g/cm^3
# =============================================================================

log             melt_quench_log.lammps

# -----------------------------------------------------------------------------
# Initialization
# -----------------------------------------------------------------------------
units           metal
dimension       3
boundary        p p p
atom_style      atomic
atom_modify     map yes
newton          on

# Read initial structure
read_data       silicone_slab.lmpdat

# MACE ML force field via MLIAP interface
# Element order: alphabetical (C, H, O, Si) to match MACE-MP training
pair_style      mliap unified mace_pretained_models/mace-mpa-0-medium.model-mliap_lammps.pt 0
pair_coeff      * * C H O Si

# -----------------------------------------------------------------------------
# Output settings (thermo only, dumps enabled after minimization)
# -----------------------------------------------------------------------------
thermo          100
thermo_style    custom step cpu spcpu temp press pe ke etotal vol density fmax fnorm
thermo_modify   flush yes

# -----------------------------------------------------------------------------
# Step 1: Energy Minimization
# -----------------------------------------------------------------------------
print "=========================================="
print "Step 1: Energy Minimization"
print "=========================================="

# Enable separate trajectory dump for minimization (saved to minimize_*.xyz/lammpstrj)
# Using larger interval (every 100 iterations) to avoid huge files
dump            min_xyz all xyz 100 minimize_traj.xyz
dump_modify     min_xyz element C H O Si

dump            min_lmp all custom 100 minimize_traj.lammpstrj id type x y z
dump_modify     min_lmp sort id

# Use relaxed tolerances appropriate for ML force fields
# etol=1e-6 (relative energy change), ftol=1e-8 eV/A (force tolerance)
minimize        1.0e-6 1.0e-8 5000 50000

# Disable minimization dumps
undump          min_xyz
undump          min_lmp

# Print density after minimization
variable        init_density equal density
print "Initial density after minimization: ${init_density} g/cm^3"

# -----------------------------------------------------------------------------
# Enable trajectory dumps for MD runs (after minimization)
# -----------------------------------------------------------------------------
# XYZ trajectory for quick visualization
dump            xyz_traj all xyz 100 trajectory.xyz
dump_modify     xyz_traj element C H O Si

# LAMMPS custom dump for MDAnalysis (includes box info)
dump            lmp_traj all custom 100 trajectory.lammpstrj id type x y z
dump_modify     lmp_traj sort id

# DCD trajectory for VMD (binary, smaller file size, includes box)
dump            dcd_traj all dcd 100 trajectory.dcd

# -----------------------------------------------------------------------------
# Step 2: Heat from 300K to 443K (170C)
# -----------------------------------------------------------------------------
print "=========================================="
print "Step 2: Heating from 300K to 443K"
print "=========================================="

velocity        all create 300.0 12345 rot yes dist gaussian
timestep        0.001

# NPT heating: ramp temperature from 300K to 443K
fix             heat all npt temp 300.0 443.0 0.1 iso 0.0 0.0 1.0
run             20000
unfix           heat

# -----------------------------------------------------------------------------
# Step 3: NPT Equilibration at 443K (curing temperature)
# -----------------------------------------------------------------------------
print "=========================================="
print "Step 3: NPT Equilibration at 443K (curing temperature)"
print "=========================================="

# Long NPT run at 443K to allow structure relaxation and densification
# At high temperature, chains can rearrange to achieve target density
fix             cure all npt temp 443.0 443.0 0.1 iso 0.0 0.0 1.0
run             50000
unfix           cure

# Check current density and decide if additional equilibration is needed
# Define density variables (equal-style: evaluated dynamically when referenced)
variable        target_density equal 1.10
variable        current_density equal density
variable        rel_error equal abs(v_current_density-v_target_density)/v_target_density
variable        rel_error_pct equal v_rel_error*100
variable        error_threshold equal 0.05

# Print current density status
print "=========================================="
print "Density check after first high-T equilibration:"
print "  Current density: ${current_density} g/cm^3"
print "  Target density:  ${target_density} g/cm^3"
print "  Relative error:  ${rel_error_pct}%%"
print "  Error threshold: 5%%"
print "=========================================="

# Additional high-T equilibration only if relative error > 5%
# Note: equal-style variables are evaluated dynamically, no need to redefine
if "${rel_error} > ${error_threshold}" then &
    "print 'Relative error > 5%%, running additional equilibration...'" &
    "fix cure2 all npt temp 443.0 443.0 0.1 iso 0.0 0.0 1.0" &
    "run 50000" &
    "unfix cure2" &
    "print 'Density after cure2: ${current_density} g/cm^3'" &
    "print 'Relative error after cure2: ${rel_error_pct}%%'"
if "${rel_error} <= ${error_threshold}" then &
    "print 'Relative error <= 5%%, density acceptable, skipping cure2'"

# -----------------------------------------------------------------------------
# Step 4: Cool down from 443K to 300K
# -----------------------------------------------------------------------------
print "=========================================="
print "Step 4: Cooling from 443K to 300K"
print "=========================================="

# Slow cooling to allow structure to equilibrate
# Cooling rate: 143K / 30000 steps = ~4.77K per 1000 steps
fix             cool all npt temp 443.0 300.0 0.1 iso 0.0 0.0 1.0
run             30000
unfix           cool

# -----------------------------------------------------------------------------
# Step 5: Final NPT Equilibration at 300K
# -----------------------------------------------------------------------------
print "=========================================="
print "Step 5: Final NPT Equilibration at 300K"
print "=========================================="

fix             equil all npt temp 300.0 300.0 0.1 iso 0.0 0.0 1.0
run             30000
unfix           equil

# -----------------------------------------------------------------------------
# Step 6: Output Final Densified Structure
# -----------------------------------------------------------------------------
print "=========================================="
print "Step 6: Writing final densified structure"
print "=========================================="

# Disable trajectory dumps before final output
undump          xyz_traj
undump          lmp_traj
undump          dcd_traj

# Write final structure in LAMMPS data format
write_data      densified_pdms.lmpdat

# Write final structure in XYZ format
dump            final all xyz 1 densified_pdms.xyz
dump_modify     final element C H O Si
run             0
undump          final

# Write restart file for further simulations
write_restart   densified_pdms.restart

# -----------------------------------------------------------------------------
# Final Summary
# -----------------------------------------------------------------------------
variable        final_density equal density
variable        final_rel_error equal abs(v_final_density-v_target_density)/v_target_density
variable        final_rel_error_pct equal v_final_rel_error*100

print "=========================================="
print "Melt-quench densification completed!"
print "=========================================="
print "Density Summary:"
print "  Initial density:  ${init_density} g/cm^3"
print "  Final density:    ${final_density} g/cm^3"
print "  Target density:   ${target_density} g/cm^3"
print "  Final rel. error: ${final_rel_error_pct}%%"
print "=========================================="
print "Output files:"
print "  - densified_pdms.lmpdat     (LAMMPS data format)"
print "  - densified_pdms.xyz        (XYZ format)"
print "  - densified_pdms.restart    (restart file)"
print "  - minimize_traj.xyz         (minimization XYZ trajectory)"
print "  - minimize_traj.lammpstrj   (minimization LAMMPS trajectory)"
print "  - trajectory.xyz            (MD XYZ trajectory)"
print "  - trajectory.lammpstrj      (MD LAMMPS trajectory with box)"
print "  - trajectory.dcd            (MD DCD binary trajectory)"
print "  - melt_quench_log.lammps    (LAMMPS log file)"
print "=========================================="
