# Disable minimization dumps
undump          min_xyz
undump          min_lmp

# Print density after minimization
variable        init_density equal density
print "Initial density after minimization: ${init_density} g/cm^3"
Initial density after minimization: 0.762757904071504 g/cm^3

# -----------------------------------------------------------------------------
# Enable trajectory dumps for MD runs (after minimization)
# -----------------------------------------------------------------------------
# XYZ trajectory for quick visualization
dump            xyz_traj all xyz 100 trajectory.xyz
dump_modify     xyz_traj element C H O Si

# LAMMPS custom dump for MDAnalysis (includes box info)
dump            lmp_traj all custom 100 trajectory.lammpstrj id type x y z
dump_modify     lmp_traj sort id

# DCD trajectory for VMD (binary, smaller file size, includes box)
dump            dcd_traj all dcd 100 trajectory.dcd

# -----------------------------------------------------------------------------
# Step 2: Heat from 300K to 443K (170C)
# -----------------------------------------------------------------------------
print "=========================================="
==========================================
print "Step 2: Heating from 300K to 443K"
Step 2: Heating from 300K to 443K
print "=========================================="
==========================================

velocity        all create 300.0 12345 rot yes dist gaussian
timestep        0.001

# NPT heating: ramp temperature from 300K to 443K
fix             heat all npt temp 300.0 443.0 0.1 iso 0.0 0.0 1.0
run             20000
