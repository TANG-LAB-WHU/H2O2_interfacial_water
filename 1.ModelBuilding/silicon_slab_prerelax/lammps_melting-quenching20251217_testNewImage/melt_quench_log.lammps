
# -----------------------------------------------------------------------------
# Initialization
# -----------------------------------------------------------------------------
units           metal
dimension       3
boundary        p p p
atom_style      atomic
atom_modify     map yes
newton          on

# Read initial structure
read_data       silicone_slab.lmpdat
Reading data file ...
  orthogonal box = (0 20.079963 0) to (22 39.159925 20)
  1 by 1 by 1 MPI processor grid
  reading atoms ...
  527 atoms
  read_data CPU = 0.028 seconds

# MACE ML force field via MLIAP interface
# Element order: alphabetical (C, H, O, Si) to match MACE-MP training
pair_style      mliap unified mace_pretained_models/mace-mpa-0-medium.model-mliap_lammps.pt 0
pair_coeff      * * C H O Si

# -----------------------------------------------------------------------------
# Output settings (thermo only, dumps enabled after minimization)
# -----------------------------------------------------------------------------
thermo          100
thermo_style    custom step cpu spcpu temp press pe ke etotal vol density fmax fnorm
thermo_modify   flush yes

# -----------------------------------------------------------------------------
# Step 1: Energy Minimization
# -----------------------------------------------------------------------------
print "=========================================="
==========================================
print "Step 1: Energy Minimization"
Step 1: Energy Minimization
print "=========================================="
==========================================

# Enable separate trajectory dump for minimization (saved to minimize_*.xyz/lammpstrj)
# Using larger interval (every 100 iterations) to avoid huge files
dump            min_xyz all xyz 100 minimize_traj.xyz
dump_modify     min_xyz element C H O Si

dump            min_lmp all custom 100 minimize_traj.lammpstrj id type x y z
dump_modify     min_lmp sort id

# Use relaxed tolerances appropriate for ML force fields
# etol=1e-6 (relative energy change), ftol=1e-8 eV/A (force tolerance)
minimize        1.0e-6 1.0e-8 5000 50000

