# HYBRID NPT-NVT LOCKING VERSION - Target: 1.10 g/cm³
# 
# Key improvements based on density rebound analysis:
# 1. REACH: Uses 1.5 GPa NPT to achieve high-density packing (~1.20 g/cm³).
# 2. LOCK: Instead of releasing to 1 bar (which causes rebound), we explicitly 
#    scale the box to exactly 1.10 g/cm³ and lock the volume using NVT.
# 3. AIMD READY: The final output structure is guaranteed to be at 1.10 g/cm³.
# =============================================================================

log             melt_quench_log.lammps

units           metal
neighbor        1.0 bin
neigh_modify    every 1 delay 0 check yes
dimension       3
boundary        p p p
atom_style      atomic
atom_modify     map yes
newton          on

read_data       silicone_slab.lmpdat

# Use dynamic model path passed from command line via -var MODEL_PT_PATH
pair_style      mliap unified ${MODEL_PT_PATH} 0
pair_coeff      * * C H O Si

thermo          100
thermo_style    custom step cpu spcpu temp press pe ke etotal vol density fmax fnorm
thermo_modify   flush yes

# Standard damping parameters for 1fs timestep
variable        tdamp equal 0.1
variable        pdamp equal 1.0

# Define step counts (Doubled for nstep_heat, nstep_compress, etc. due to 0.5fs dt)
variable        nstep_heat equal 10000
variable        nstep_compress equal 20000
variable        nstep_hold1 equal 4000
variable        nstep_cool equal 10000
variable        nstep_hold2 equal 4000
variable        nstep_scale equal 10000
variable        nstep_equil equal 10000

variable        dt_val equal 0.0005
variable        total_steps equal ${nstep_heat}+${nstep_compress}+${nstep_hold1}+${nstep_cool}+${nstep_hold2}+${nstep_scale}+${nstep_equil}
variable        total_time equal ${total_steps}*${dt_val}

# Individual phase times for breakdown
variable        t_heat     equal ${nstep_heat}*${dt_val}
variable        t_compress equal ${nstep_compress}*${dt_val}
variable        t_hold     equal (${nstep_hold1}+${nstep_cool}+${nstep_hold2})*${dt_val}
variable        t_scale    equal ${nstep_scale}*${dt_val}
variable        t_equil    equal ${nstep_equil}*${dt_val}

# -----------------------------------------------------------------------------
# Master trajectory dump - captures entire simulation (minimization + MD)
# -----------------------------------------------------------------------------
dump            full_traj all xyz 500 full_trajectory.xyz
dump_modify     full_traj element C H O Si

dump            full_lmp all custom 500 full_trajectory.lammpstrj id type x y z
dump_modify     full_lmp sort id

# -----------------------------------------------------------------------------
# Step 1: Quick Minimization
# -----------------------------------------------------------------------------
print "Step 1: Quick Minimization"
dump            min_xyz all xyz 100 minimize_traj.xyz
dump_modify     min_xyz element C H O Si

dump            min_lmp all custom 100 minimize_traj.lammpstrj id type x y z
dump_modify     min_lmp sort id

minimize        0.0 1.0e-8 5000 50000

undump          min_xyz
undump          min_lmp

variable        init_density equal $(density)
print "Initial density: ${init_density} g/cm^3"

# -----------------------------------------------------------------------------
# Enable trajectory dumps for MD runs
# -----------------------------------------------------------------------------
dump            xyz_traj all xyz 100 trajectory.xyz
dump_modify     xyz_traj element C H O Si

dump            lmp_traj all custom 100 trajectory.lammpstrj id type x y z
dump_modify     lmp_traj sort id

dump            dcd_traj all dcd 100 trajectory.dcd

velocity        all create 300.0 12345 rot yes dist gaussian
timestep        ${dt_val}

# -----------------------------------------------------------------------------
# Step 2: Heating 300K -> 500K
# -----------------------------------------------------------------------------
print "Step 2: Heating 300K -> 500K (${nstep_heat} steps)"

fix             heat all npt temp 300.0 500.0 ${tdamp} iso 1.0 1.0 ${pdamp}
run             ${nstep_heat}
unfix           heat

# -----------------------------------------------------------------------------
# Step 3: Compression to 1.5 GPa (15,000 bar)
# -----------------------------------------------------------------------------
print "Step 3: Compression 1.0 bar -> 15000.0 bar (${nstep_compress} steps)"

fix             compress all npt temp 500.0 500.0 ${tdamp} iso 1.0 15000.0 ${pdamp}
run             ${nstep_compress}
unfix           compress

variable        compressed_density equal $(density)
print "==========================================="
print "Density after compression (15000 bar): ${compressed_density} g/cm^3"
print "==========================================="

# -----------------------------------------------------------------------------
# Step 4: Hold and Cool to lock structure
# -----------------------------------------------------------------------------
print "Step 4a: Hold at 15000 bar - high temp (${nstep_hold1} steps)"
fix             hold1 all npt temp 500.0 500.0 ${tdamp} iso 15000.0 15000.0 ${pdamp}
run             ${nstep_hold1}
unfix           hold1

print "Step 4b: Cool to 300K under 15000 bar pressure (${nstep_cool} steps)"
fix             anneal1 all npt temp 500.0 300.0 ${tdamp} iso 15000.0 15000.0 ${pdamp}
run             ${nstep_cool}
unfix           anneal1

print "Step 4c: Hold at 300K under 15000 bar - LOCK STRUCTURE (${nstep_hold2} steps)"
fix             anneal1b all npt temp 300.0 300.0 ${tdamp} iso 15000.0 15000.0 ${pdamp}
run             ${nstep_hold2}
unfix           anneal1b

variable        density_cool equal $(density)
print "Density after cooling at 15000 bar: ${density_cool} g/cm^3"

# -----------------------------------------------------------------------------
# Step 5: Explicit Scaling to Target Density (Volume Locking)
# -----------------------------------------------------------------------------
print "Step 5: Scaling box from current high density to exactly 1.10 g/cm^3 (${nstep_scale} steps)"

variable        target_rho equal 1.10
variable        current_rho equal $(density)
variable        scale_factor equal (v_current_rho/v_target_rho)^(1.0/3.0)

variable        lx_target equal $(lx*v_scale_factor)
variable        ly_target equal $(ly*v_scale_factor)
variable        lz_target equal $(lz*v_scale_factor)

print "Current density: ${current_rho} g/cm^3"
print "Scaling factor to reach 1.10: ${scale_factor}"

# Smoothly scale the box over the steps
fix             step5_deform all deform 1 x final 0.0 ${lx_target} y final 0.0 ${ly_target} z final 0.0 ${lz_target} remap x
fix             step5_nvt all nvt temp 300.0 300.0 ${tdamp}
run             ${nstep_scale}
unfix           step5_nvt
unfix           step5_deform

# -----------------------------------------------------------------------------
# Step 6: Final NVT Equilibration (Fixed Volume at 1.10 g/cm³)
# -----------------------------------------------------------------------------
print "Step 6: Final NVT equilibration at 300K, Target Density (${nstep_equil} steps)"

fix             final_nvt all nvt temp 300.0 300.0 ${tdamp}
run             ${nstep_equil}
unfix           final_nvt

# -----------------------------------------------------------------------------
# Output
# -----------------------------------------------------------------------------
undump          xyz_traj
undump          lmp_traj
undump          dcd_traj
undump          full_traj
undump          full_lmp

write_data      densified_pdms.lmpdat

dump            final all xyz 1 densified_pdms.xyz
dump_modify     final element C H O Si
run             0
undump          final

write_restart   densified_pdms.restart

# -----------------------------------------------------------------------------
# Summary
# -----------------------------------------------------------------------------
variable        target_density equal 1.10
variable        final_density equal $(density)
variable        rel_error equal abs(v_final_density-v_target_density)/v_target_density*100

print "==========================================="
print "HYBRID NPT-NVT LOCKING Complete!"
print "==========================================="
print "Density Summary (Goal: 1.10 g/cm^3):"
print "  Initial density:     ${init_density} g/cm^3"
print "  After compression:   ${compressed_density} g/cm^3"
print "  Final density:       ${final_density} g/cm^3"
print "  Target:              ${target_density} g/cm^3"
print "  Relative error:      ${rel_error}%%"
print "==========================================="
print "Output files:"
print "  - densified_pdms.lmpdat     (LAMMPS data format)"
print "  - densified_pdms.xyz        (XYZ format)"
print "  - densified_pdms.restart    (restart file)"
print "  - full_trajectory.xyz       (complete XYZ trajectory)"
print "  - full_trajectory.lammpstrj (complete LAMMPS trajectory)"
print "  - trajectory.xyz            (MD XYZ trajectory)"
print "  - trajectory.lammpstrj      (MD LAMMPS trajectory)"
print "  - trajectory.dcd            (MD DCD trajectory)"
print "  - melt_quench_log.lammps    (LAMMPS log file)"
print "==========================================="
print "Total Time Breakdown (ps):"
print "  Heating(${t_heat}) + Compress(${t_compress}) + Anneal(${t_hold}) + Scale(${t_scale}) + Equil(${t_equil}) = ${total_time} ps"
print "Total Steps: ${total_steps}"
print "Strategy: NPT Packing (1.5 GPa) -> Volume Scaling -> NVT Locking"
print "==========================================="
