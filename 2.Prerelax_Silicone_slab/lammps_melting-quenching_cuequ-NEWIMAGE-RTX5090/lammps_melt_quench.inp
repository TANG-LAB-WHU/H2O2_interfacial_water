# =============================================================================
# LAMMPS input script for PDMS melt-quench densification
# =============================================================================
# OPTIMIZED VERSION v3 - Target: 1.10 g/cm³ - True T-P Annealing (100k)
# 
# Key improvements:
# 1. Increased timestep to 1 fs
# 2. Proper Melt phase at 1000K to fluidize polymer before applying pressure
# 3. Aggressive Quench under 2 GPa pressure
# 4. Total simulation time extended to 100 ps for physical relaxation 
# =============================================================================

log             melt_quench_log.lammps

units           metal
neighbor        1.0 bin
dimension       3
boundary        p p p
atom_style      atomic
atom_modify     map yes
newton          on

read_data       silicone_slab.lmpdat

# Use dynamic model path passed from command line via -var MODEL_PT_PATH
pair_style      mliap unified ${MODEL_PT_PATH} 0
pair_coeff      * * C H O Si

thermo          100
thermo_style    custom step cpu spcpu temp press pe ke etotal vol density fmax fnorm
thermo_modify   flush yes

# Optimized damping parameters for stable MACE NPT
variable        tdamp equal 0.1
variable        pdamp equal 2.0

# -----------------------------------------------------------------------------
# Master trajectory dump - captures entire simulation (minimization + MD)
# -----------------------------------------------------------------------------
dump            full_traj all xyz 500 full_trajectory.xyz
dump_modify     full_traj element C H O Si

dump            full_lmp all custom 500 full_trajectory.lammpstrj id type x y z
dump_modify     full_lmp sort id

# -----------------------------------------------------------------------------
# Step 1: Quick Minimization
# -----------------------------------------------------------------------------
print "Step 1: Quick Minimization"
dump            min_xyz all xyz 100 minimize_traj.xyz
dump_modify     min_xyz element C H O Si

dump            min_lmp all custom 100 minimize_traj.lammpstrj id type x y z
dump_modify     min_lmp sort id

minimize        0.0 1.0e-8 5000 50000

undump          min_xyz
undump          min_lmp

variable        init_density equal $(density)
print "Initial density: ${init_density} g/cm^3"

# -----------------------------------------------------------------------------
# Enable trajectory dumps for MD runs
# -----------------------------------------------------------------------------
dump            xyz_traj all xyz 100 trajectory.xyz
dump_modify     xyz_traj element C H O Si

dump            lmp_traj all custom 100 trajectory.lammpstrj id type x y z
dump_modify     lmp_traj sort id

dump            dcd_traj all dcd 100 trajectory.dcd

velocity        all create 300.0 12345 rot yes dist gaussian
timestep        0.001

# -----------------------------------------------------------------------------
# Phase 1: High-Temp Melt (300K -> 1000K, 1.0 bar, 10 ps)
# -----------------------------------------------------------------------------
print "Phase 1: Heating to 1000K to fluidize polymer (10,000 steps)"
fix             p1 all npt temp 300.0 1000.0 ${tdamp} iso 1.0 1.0 ${pdamp}
run             10000
unfix           p1

# -----------------------------------------------------------------------------
# Phase 2: High-Temp Compression to 2 GPa (1000K, 1.0 -> 20000.0 bar, 20 ps)
# -----------------------------------------------------------------------------
print "Phase 2: Compressing fluid to 2 GPa at 1000K (20,000 steps)"
fix             p2 all npt temp 1000.0 1000.0 ${tdamp} iso 1.0 20000.0 ${pdamp}
run             20000
unfix           p2

variable        compressed_density_hight equal $(density)
print "==========================================="
print "Density after high-T compression: ${compressed_density_hight} g/cm^3"
print "==========================================="

# -----------------------------------------------------------------------------
# Phase 3: Quench under 2 GPa Pressure (1000K -> 300K, 20000.0 bar, 40 ps)
# -----------------------------------------------------------------------------
print "Phase 3: Thermal quench under high pressure to lock density (40,000 steps)"
fix             p3 all npt temp 1000.0 300.0 ${tdamp} iso 20000.0 20000.0 ${pdamp}
run             40000
unfix           p3

variable        compressed_density_lowt equal $(density)
print "Density after 300K quench: ${compressed_density_lowt} g/cm^3"

# -----------------------------------------------------------------------------
# Phase 4: Slower Pressure Release (300K, 20000.0 -> 1.0 bar, 20 ps)
# -----------------------------------------------------------------------------
print "Phase 4: Pressure release at 300K (20,000 steps)"
fix             p4 all npt temp 300.0 300.0 ${tdamp} iso 20000.0 1.0 ${pdamp}
run             20000
unfix           p4

# -----------------------------------------------------------------------------
# Phase 5: Final Ambient Equilibration (300K, 1.0 bar, 10 ps)
# -----------------------------------------------------------------------------
print "Phase 5: Final NPT equilibration at 300K and 1 bar (10,000 steps)"
fix             p5 all npt temp 300.0 300.0 ${tdamp} iso 1.0 1.0 ${pdamp}
run             10000
unfix           p5

# -----------------------------------------------------------------------------
# Output
# -----------------------------------------------------------------------------
undump          xyz_traj
undump          lmp_traj
undump          dcd_traj
undump          full_traj
undump          full_lmp

write_data      densified_pdms.lmpdat

dump            final all xyz 1 densified_pdms.xyz
dump_modify     final element C H O Si
run             0
undump          final

write_restart   densified_pdms.restart

# -----------------------------------------------------------------------------
# Summary
# -----------------------------------------------------------------------------
variable        target_density equal 1.10
variable        final_density_snapshot equal $(density)
variable        rel_error equal abs(v_final_density_snapshot-v_target_density)/v_target_density*100

print "==========================================="
print "V3 True T-P Annealing (100k) Complete!"
print "==========================================="
print "Density Summary (Target: 1.10 g/cm^3):"
print "  Initial density:            ${init_density} g/cm^3"
print "  After high-T compression:   ${compressed_density_hight} g/cm^3"
print "  After quench compression:   ${compressed_density_lowt} g/cm^3"
print "  Final density:              ${final_density_snapshot} g/cm^3"
print "  Target:                     ${target_density} g/cm^3"
print "  Relative error:             ${rel_error}%%"
print "==========================================="
print "Output files:"
print "  - densified_pdms.lmpdat     (LAMMPS data format)"
print "  - densified_pdms.xyz        (XYZ format)"
print "  - densified_pdms.restart    (restart file)"
print "  - full_trajectory.xyz       (complete XYZ trajectory)"
print "  - full_trajectory.lammpstrj (complete LAMMPS trajectory)"
print "  - trajectory.xyz            (MD XYZ trajectory)"
print "  - trajectory.lammpstrj      (MD LAMMPS trajectory)"
print "  - trajectory.dcd            (MD DCD trajectory)"
print "  - melt_quench_log.lammps    (LAMMPS log file)"
print "==========================================="
print "Total: 100,000 steps (~2.5 hours)"
print "Strategy: True T-P Annealing (Melt, Compress 2GPa, Quench, Release)"
print "==========================================="
