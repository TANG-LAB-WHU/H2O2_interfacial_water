# LAMMPS input script for i-PI client mode
# This example uses MACE ML potential - modify pair_style as needed

units           metal
atom_style      atomic
boundary        p p p

# Read initial structure
read_data       data.lmp

# Define potential (example: MACE ML potential)
# Modify this section for your specific force field
pair_style      mace
pair_coeff      * * model.pt C H O

# Neighbor list settings
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes

# Connect to i-PI server via UNIX socket
fix             1 all ipi ipi-socket 31415 unix

# Run indefinitely (i-PI controls the simulation)
run             1000000000
