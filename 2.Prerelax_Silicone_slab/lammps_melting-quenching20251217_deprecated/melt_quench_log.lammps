unfix           cure

# Check current density and decide if additional equilibration is needed
# Define density variables (equal-style: evaluated dynamically when referenced)
variable        target_density equal 1.10
variable        current_density equal density
variable        rel_error equal abs(v_current_density-v_target_density)/v_target_density
variable        rel_error_pct equal v_rel_error*100
variable        error_threshold equal 0.05

# Print current density status
print "=========================================="
==========================================
print "Density check after first high-T equilibration:"
Density check after first high-T equilibration:
print "  Current density: ${current_density} g/cm^3"
  Current density: 0.84550422189051 g/cm^3
print "  Target density:  ${target_density} g/cm^3"
  Target density:  1.1 g/cm^3
print "  Relative error:  ${rel_error_pct}%%"
  Relative error:  23.1359798281355%%
print "  Error threshold: 5%%"
  Error threshold: 5%%
print "=========================================="
==========================================

# Additional high-T equilibration only if relative error > 5%
# Note: equal-style variables are evaluated dynamically, no need to redefine
if "${rel_error} > ${error_threshold}" then     "print 'Relative error > 5%%, running additional equilibration...'"     "fix cure2 all npt temp 443.0 443.0 0.1 iso 0.0 0.0 1.0"     "run 50000"     "unfix cure2"     "print 'Density after cure2: ${current_density} g/cm^3'"     "print 'Relative error after cure2: ${rel_error_pct}%%'"
print 'Relative error > 5%%, running additional equilibration...'
Relative error > 5%%, running additional equilibration...
fix cure2 all npt temp 443.0 443.0 0.1 iso 0.0 0.0 1.0
run 50000
