@SET EPS_SCF 3.9E-4

&GLOBAL
  PROJECT silicone_water_50_geo_opt
  RUN_TYPE GEO_OPT
  PRINT_LEVEL MEDIUM
  ELPA_KERNEL AVX2_BLOCK4
&END GLOBAL

&MOTION
  &GEO_OPT
    TYPE MINIMIZATION
    OPTIMIZER BFGS
    MAX_ITER 500
    MAX_DR 3.0E-3
    MAX_FORCE 4.5E-4
    RMS_DR 1.5E-3
    RMS_FORCE 3.0E-4
  &END GEO_OPT
  &PRINT
    &TRAJECTORY
      FORMAT XYZ
      &EACH
        GEO_OPT 1
      &END EACH
    &END TRAJECTORY
    &RESTART
      &EACH
        GEO_OPT 10
      &END EACH
    &END RESTART
  &END PRINT
&END MOTION

&FORCE_EVAL
  METHOD QS
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT_UZH
    POTENTIAL_FILE_NAME POTENTIAL_UZH
    CHARGE 0
    MULTIPLICITY 1
    
    &MGRID
      CUTOFF 600
      REL_CUTOFF 60
      NGRIDS 5
    &END MGRID
    
    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-12
      EXTRAPOLATION ASPC
      EXTRAPOLATION_ORDER 3
    &END QS
    
    &POISSON
      PERIODIC XYZ
      POISSON_SOLVER PERIODIC
    &END POISSON
    
    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF ${EPS_SCF}
      MAX_SCF 300
      IGNORE_CONVERGENCE_FAILURE
      &OT ON
        MINIMIZER DIIS
        PRECONDITIONER FULL_SINGLE_INVERSE
        #ALGORITHM IRAC
        ENERGY_GAP 0.01
        LINESEARCH 2PNT
        STEPSIZE 0.01
      &END OT
      &OUTER_SCF
        EPS_SCF ${EPS_SCF}
        MAX_SCF 50
      &END OUTER_SCF
      &PRINT
        &RESTART
          BACKUP_COPIES 1
          &EACH
            QS_SCF 10
          &END EACH
        &END RESTART
      &END PRINT
    &END SCF
    
    &XC
      &XC_FUNCTIONAL
        &MGGA_X_R2SCAN
        &END MGGA_X_R2SCAN
        &MGGA_C_R2SCAN
        &END MGGA_C_R2SCAN
      &END XC_FUNCTIONAL
      &VDW_POTENTIAL
        DISPERSION_FUNCTIONAL NON_LOCAL
        &NON_LOCAL
          TYPE RVV10
          KERNEL_FILE_NAME rVV10_kernel_table.dat
          PARAMETERS 11.95 0.0093
          CUTOFF 80
        &END NON_LOCAL
      &END VDW_POTENTIAL
      DENSITY_SMOOTH_CUTOFF_RANGE 0.5
    &END XC
    
    #&PERIODIC_EFIELD
    #  INTENSITY 0.007
    #  POLARISATION 0.0 0.0 1.0
    #&END PERIODIC_EFIELD
    ! Electric field to simulate water microdroplet interface conditions
    ! Field strength ~10^9 V/m (~0.36 V/Å) along z-axis (interface normal)
    ! Using displacement field formulation for better interface description
    &PERIODIC_EFIELD
      INTENSITY 0.007              ! a.u. (~0.36 V/Å = 3.6×10^9 V/m)
      POLARISATION 0.0 0.0 1.0     ! Direction: z-axis (perpendicular to interface)
      DISPLACEMENT_FIELD     ! Use displacement field formulation (Stengel2009)
      # D_FILTER 0.0 0.0 1.0         ! Apply only along z-direction
      D_FILTER 1.0 1.0 1.0         ! Apply to all directions
    &END PERIODIC_EFIELD
    
    &PRINT
      &E_DENSITY_CUBE OFF
      &END E_DENSITY_CUBE
      &MO_CUBES OFF
      &END MO_CUBES
    &END PRINT
  &END DFT
  
  &SUBSYS
    &CELL
      ABC 22.0 19.07996254642244 46.35162
      ALPHA_BETA_GAMMA 90.0 90.0 90.0
      PERIODIC XYZ
    &END CELL
    
    &TOPOLOGY
      COORD_FILE_NAME silicone_water_box_optimized.xyz
      COORD_FILE_FORMAT XYZ
    &END TOPOLOGY
    
    &KIND Si
      BASIS_SET TZVP-MOLOPT-MGGA-GTH-q4
      POTENTIAL GTH-MGGA-q4
    &END KIND
    
    &KIND O
      BASIS_SET TZVP-MOLOPT-MGGA-GTH-q6
      POTENTIAL GTH-MGGA-q6
    &END KIND
    
    &KIND C
      BASIS_SET TZVP-MOLOPT-MGGA-GTH-q4
      POTENTIAL GTH-MGGA-q4
    &END KIND
    
    &KIND H
      BASIS_SET TZVP-MOLOPT-MGGA-GTH-q1
      POTENTIAL GTH-MGGA-q1
    &END KIND
  &END SUBSYS
&END FORCE_EVAL
