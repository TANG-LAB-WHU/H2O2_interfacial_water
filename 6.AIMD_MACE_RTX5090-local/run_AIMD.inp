# =============================================================================
# LAMMPS input script for water-PDMS interface production AIMD simulation using MACE
# =============================================================================

units           metal
neighbor        2.0 bin
neigh_modify    every 1 delay 0 check yes
dimension       3
boundary        p p p
atom_style      atomic
atom_modify     map yes
newton          on

read_data       assembled_interface.lmpdat

# Use dynamic model path passed from command line via -var MODEL_PT_PATH
pair_style      mliap unified ${MODEL_PT_PATH} 0
pair_coeff      * * C H O Si

thermo          100
thermo_style    custom step cpu spcpu temp press pe ke etotal vol density fmax fnorm
thermo_modify   flush yes

# --- Key parameters ---
variable        dt_val equal 0.0005    # 0.5 fs timestep
variable        tdamp equal 0.05       # 100 * dt

# =============================================================================
# Trajectory dump
# =============================================================================
dump            xyz_traj all xyz 100 trajectory_interface.xyz
dump_modify     xyz_traj element C H O Si

dump            lmp_traj all custom 100 trajectory_interface.lammpstrj id type x y z
dump_modify     lmp_traj sort id

# =============================================================================
# Phase 1: Energy Minimization
# =============================================================================
print "Phase 1: Energy Minimization"
minimize        0.0 1.0e-8 5000 50000

# =============================================================================
# Local Density Profile along Z-axis (Active during Production Run)
# =============================================================================
# Define 1D bins (chunks) along the Z-direction starting from the bottom of the box
# Bin width: 0.5 Angstroms (provides high spatial resolution)
compute         z_chunks all chunk/atom bin/1d z lower 0.5

# Calculate time-averaged mass density profile along Z
# Nevery = 10, Nrepeat = 100, Nfreq = 1000:
# It averages every 10 steps, takes 100 samples, and outputs the average profile every 1000 steps (0.5 ps)
# Note: 'density/mass' under 'units metal' outputs in g/mol/A^3.
#       To convert to standard g/cm^3, multiply the output values by 1.66054.
fix             dens_profile all ave/chunk 10 100 1000 z_chunks density/mass file mass_density_profile.out

# =============================================================================
# Phase 2: NVT Production AIMD Run
# =============================================================================
velocity        all create 298.0 12345 rot yes dist gaussian
timestep        ${dt_val}

print "Phase 2: NVT Production AIMD Run at 298K"

fix             nvt_prod all nvt temp 298.0 298.0 ${tdamp}
run             50000
unfix           nvt_prod

# =============================================================================
# Output
# =============================================================================
undump          xyz_traj
undump          lmp_traj
unfix           dens_profile
uncompute       z_chunks

write_data      assembled_interface_relaxed.lmpdat
write_restart   assembled_interface_relaxed.restart

dump            final all xyz 1 assembled_interface_relaxed.xyz
dump_modify     final element C H O Si
run             0
undump          final

print "==========================================="
print "NVT Production AIMD Run Complete!"
print "Final Density: $(density) g/cm^3"
print "Output files: assembled_interface_relaxed.lmpdat, assembled_interface_relaxed.xyz, trajectory_interface.xyz"
print "==========================================="
